# Copy to /etc/blackpearl/blackpearl.env (mode 600, owned by root). Never commit the real file.
# Cloudflare Realtime TURN key: Cloudflare dashboard > Realtime > TURN Server.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Set to true only to test relay-only connections.
BLACKPEARL_FORCE_RELAY=false
# Sentry DSN of the server's project (Sentry > Settings > Projects > Client Keys). Empty sends no error reports.
BLACKPEARL_SENTRY_DSN=
# Log levels and format (README.md, "Logs"). For example, a line for every signal relayed:
# Logging__LogLevel__BlackPearl=Debug
